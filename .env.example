# Copie para .env na VPS (o .env nunca vai para o GitHub).

# Rede Docker onde está o Nginx Proxy Manager. Para descobrir:
#   docker inspect <container-do-npm> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=npm_default

# Chaves de 64 caracteres hexadecimais. Opcional: se ficarem vazias, o sistema
# usa dados/db.key e dados/secret.key (criados sozinhos na primeira execução,
# ou copiados do seu computador para manter o banco atual).
ABSENTEISMO_DB_KEY=
ABSENTEISMO_SECRET_KEY=
